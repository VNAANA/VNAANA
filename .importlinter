
[importlinter]
root_package = Backend

[importlinter:contract:logic-independent]
name = Logic is independent
type = forbidden
source_modules =
    Backend.Logic
forbidden_modules =
    Backend.Dal
    Backend.Presentation

[importlinter:contract:dal-independent-of-presentation]
name = DAL cannot depend on Presentation
type = forbidden
source_modules =
    Backend.Dal
forbidden_modules =
    Backend.Presentation
