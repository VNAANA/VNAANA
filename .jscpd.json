{
  "threshold": 5,
  "minLines": 5,
  "minTokens": 50,
  "reporters": [
    "console"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/tests/**",
    "**/*/tests/**",
    "**/migrations/**",
    "**/Testing_ENV/**"
  ],
  "absolute": true
}
